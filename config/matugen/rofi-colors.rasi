/* genere par matugen a partir du fond d ecran, ne pas editer a la main */
/* modele : config/matugen/rofi-colors.rasi dans le repo nixos-config */
* {
    bg:         {{ colors.surface.default.hex }}ee;
    bg-alt:     {{ colors.surface_container_high.default.hex }};
    fg:         {{ colors.on_surface.default.hex }};
    fg-dim:     {{ colors.outline.default.hex }};
    accent:     {{ colors.primary.default.hex }};
    accent-alt: {{ colors.tertiary.default.hex }};
    blue:       {{ colors.secondary.default.hex }};
    urgent:     {{ colors.error.default.hex }};
}
